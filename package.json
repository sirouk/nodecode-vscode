{
  "name": "nodecode-vscode",
  "displayName": "Nodecode",
  "description": "Nodecode in VS Code: the gateway's own page in your sidebar or an editor tab, with nothing in between.",
  "version": "0.2.7",
  "publisher": "sirouk",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "nodecode",
    "ai agent",
    "coding agent",
    "agent",
    "gateway",
    "web",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sirouk/nodecode-vscode"
  },
  "homepage": "https://github.com/sirouk/nodecode-vscode",
  "bugs": {
    "url": "https://github.com/sirouk/nodecode-vscode/issues"
  },
  "galleryBanner": {
    "color": "#171716",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Shows the local Nodecode gateway's own page. It reads the gateway's port and operator token from ~/.nodecode and touches no workspace file."
    },
    "virtualWorkspaces": true
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Nodecode",
      "properties": {
        "nodecode.cliPath": {
          "type": "string",
          "default": "nodecode",
          "description": "Path to the nodecode CLI binary, or a bare name resolved against PATH. The extension uses it only to start the gateway and turn the web cell on."
        },
        "nodecode.diagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose diagnostics in the Nodecode output channel."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nodecode",
          "title": "Nodecode",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "nodecode": [
        {
          "id": "nodecodeWeb",
          "type": "webview",
          "name": "Nodecode",
          "contextualTitle": "Nodecode"
        }
      ]
    },
    "commands": [
      {
        "command": "nodecode.open",
        "title": "Open Nodecode",
        "category": "Nodecode",
        "icon": "$(chip)"
      },
      {
        "command": "nodecode.openInEditor",
        "title": "Open Nodecode in an Editor Tab",
        "category": "Nodecode",
        "icon": "$(open-preview)"
      },
      {
        "command": "nodecode.openInBrowser",
        "title": "Open the Page in Your Browser",
        "category": "Nodecode",
        "icon": "$(link-external)"
      },
      {
        "command": "nodecode.copyLink",
        "title": "Copy the Page Link",
        "category": "Nodecode",
        "icon": "$(clippy)"
      },
      {
        "command": "nodecode.reload",
        "title": "Reload the Page",
        "category": "Nodecode",
        "icon": "$(refresh)"
      },
      {
        "command": "nodecode.enableWebCell",
        "title": "Turn On the Web Cell",
        "category": "Nodecode",
        "icon": "$(check)"
      },
      {
        "command": "nodecode.startGateway",
        "title": "Start the Gateway",
        "category": "Nodecode",
        "icon": "$(play)"
      },
      {
        "command": "nodecode.install",
        "title": "Install Nodecode",
        "category": "Nodecode",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nodecode.showDiagnostics",
        "title": "Show Diagnostics Output",
        "category": "Nodecode",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nodecode.enableWebCell"
        },
        {
          "command": "nodecode.startGateway"
        },
        {
          "command": "nodecode.install"
        }
      ],
      "view/title": [
        {
          "command": "nodecode.reload",
          "when": "view == nodecodeWeb",
          "group": "navigation@1"
        },
        {
          "command": "nodecode.openInEditor",
          "when": "view == nodecodeWeb",
          "group": "navigation@2"
        },
        {
          "command": "nodecode.openInBrowser",
          "when": "view == nodecodeWeb",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && node --test test/*.test.mjs && node ./test/parity.mjs",
    "package": "npx @vscode/vsce package --no-dependencies",
    "icon": "node test/render-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.0"
  }
}
